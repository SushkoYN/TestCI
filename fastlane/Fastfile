# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      project: "TestCI.xcodeproj",
      scheme: "TestCI",
      device: "iPhone 17 (27.2)",
      only_testing: ["TestCITests"],
      cloned_source_packages_path: ".spm",
      clean: true
    )
  end

  desc "Check App Store Connect API access"
  lane :asc_check do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    app = Spaceship::ConnectAPI::App.find("YS.TestCI")
    UI.user_error!("App YS.TestCI not found in App Store Connect") unless app
    UI.success("Connected. App: #{app.name}")
  end

end
