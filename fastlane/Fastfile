# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      project: "TestCI.xcodeproj",
      scheme: "TestCI",
      device: "iPhone 17 (27.2)",
      only_testing: ["TestCITests"],
      cloned_source_packages_path: ".spm",
      clean: true
    )
  end

  desc "Check App Store Connect API access"
  lane :asc_check do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    app = Spaceship::ConnectAPI::App.find("YS.TestCI")
    UI.user_error!("App YS.TestCI not found in App Store Connect") unless app
    UI.success("Connected. App: #{app.name}")
  end

  desc "Sync App Store signing (readonly on CI)"
  lane :sync_signing do
    setup_ci if is_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    match(type: "appstore", readonly: is_ci, api_key: api_key)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if is_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    match(type: "appstore", readonly: is_ci, api_key: api_key)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "YS.TestCI"
    ) + 1

    root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    build_dir = File.join(root, "build")
    archive_path = File.join(build_dir, "TestCI.xcarchive")
    export_path = File.join(build_dir, "export")
    export_options = File.join(build_dir, "ExportOptions.plist")

    FileUtils.rm_rf(build_dir)
    FileUtils.mkdir_p(build_dir)
    File.write(export_options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>signingStyle</key><string>manual</string>
        <key>teamID</key><string>69QY2U37R8</string>
        <key>provisioningProfiles</key>
        <dict><key>YS.TestCI</key><string>match AppStore YS.TestCI</string></dict>
        <key>destination</key><string>export</string>
      </dict>
      </plist>
    PLIST

    sh(
      "xcodebuild", "archive", "-quiet",
      "-project", File.join(root, "TestCI.xcodeproj"),
      "-scheme", "TestCI",
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "-clonedSourcePackagesDirPath", File.join(root, ".spm"),
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=Apple Distribution",
      "PROVISIONING_PROFILE_SPECIFIER=match AppStore YS.TestCI",
      "DEVELOPMENT_TEAM=69QY2U37R8",
      "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    sh(
      "xcodebuild", "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", export_path,
      "-exportOptionsPlist", export_options
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(export_path, "TestCI.ipa"),
      skip_waiting_for_build_processing: true
    )
  end
end
